* text=auto

# Arquivos multiplataforma mantidos como LF no repositório
.gitattributes text eol=lf
.gitignore     text eol=lf
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Scripts nativos do Windows mantidos como CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
